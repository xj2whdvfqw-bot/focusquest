IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1
PRODUCT_BUNDLE_IDENTIFIER = com.focusquest.app

// Klice, ktere INFOPLIST_KEY_* neumi (fonty, Live Activities, rezim pozadi), jsou v Support/FocusQuest-Info.plist.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Support/FocusQuest-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = FocusQuest
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
// MARKETING_VERSION a CURRENT_PROJECT_VERSION jsou v project.yml (spolecne s Widget Extension).
